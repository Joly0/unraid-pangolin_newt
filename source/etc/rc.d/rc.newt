#!/bin/bash
#
# rc.newt - service control for the Pangolin Newt site connector on Unraid
#
# Newt registers this server with a Pangolin instance as a *site*, so that
# resources running on this host (Docker containers, shares, the webGui, ...)
# can be published through Pangolin. It is a fully user space WireGuard client:
# it creates no network interface and does not touch the system resolver, so
# unlike the Pangolin CLI plugin there is nothing here to firewall or restore.
#
# Connection settings are managed from Settings > Pangolin Newt in the webGui
# and stored in the plugin .cfg on the flash drive.
#
# Usage: rc.newt {start|stop|restart|apply|status|autostart|watchdog|sync-binary}
#

PLUGIN="pangolin_newt"
CFG="/boot/config/plugins/${PLUGIN}/${PLUGIN}.cfg"
BIN="/usr/local/bin/newt"
PERSIST="/boot/config/plugins/${PLUGIN}/newt"
PIDFILE="/var/run/${PLUGIN}.pid"
LOG="/var/log/${PLUGIN}.log"
# Newt writes "ok" here once its tunnel ping succeeds and deletes it when the
# connection drops, so this file - not the process - is what "connected" means.
# It is deliberately under /var/run: it must not survive a reboot.
HEALTH="/var/run/${PLUGIN}.health"
# Records that the service is *meant* to be connected. Created by start,
# removed by stop, so the watchdog below can tell "it fell over" apart from
# "the user pressed Disconnect" and never undoes a deliberate disconnect.
WANTFILE="/var/run/${PLUGIN}.want"
# pgrep/pkill -f pattern (ERE over the full command line), anchored so it only
# matches the service-launched process (argv[0] is the absolute binary path) -
# never an interactive "newt --help" or an unrelated process that happens to
# mention the binary path in its arguments.
PGREP_NEWT="^${BIN}( |$)"

# How many times start() will relaunch Newt when it comes up but never reaches
# a connected state, and how long (in half-seconds) to wait for each attempt.
# Newt's registration handshake with the server fails intermittently - it logs
# "SendMessageInterval timed out ... newt/wg/register", keeps the process alive
# and then sits there forever without retrying, so the only cure is a fresh
# process. Measured on a live server: a single attempt succeeds roughly half
# the time, three attempts make a failed connect very unlikely.
START_ATTEMPTS=3
START_WAIT=30

# Defaults (overridden by the webGui settings below)
PANGOLIN_ENDPOINT=""
NEWT_ID=""
NEWT_SECRET=""
AUTOSTART="no"
# Publish Unraid's Docker socket to Newt so the Pangolin dashboard can list
# this server's containers when you pick targets for a resource. Read-only
# discovery; Newt never starts or stops anything.
DOCKER_INTEGRATION="yes"
LOG_LEVEL="INFO"
# Newt can update its own binary from your Pangolin server (2 minutes after
# start, then every 6 hours) and re-exec into it. Off by default: the plugin
# owns the version, the same way the Pangolin CLI plugin does. See start().
SELF_UPDATE="no"
EXTRA_ARGS=""

# Load settings written by the webGui (KEY="value" lines)
[ -f "$CFG" ] && . "$CFG"

ensure_bin() {
  # Unraid's root filesystem lives in RAM and is rebuilt on every boot, so the
  # binary is kept on the flash drive and restored to PATH when missing.
  if [ ! -x "$BIN" ] && [ -s "$PERSIST" ]; then
    install -D -m 0755 "$PERSIST" "$BIN"
  fi
}

ensure_tun() {
  # Newt's default (netstack) mode is entirely user space and needs no TUN
  # device. Only --native / --native-main ask the kernel for a real WireGuard
  # interface, so the device is set up only when the user opted into that.
  case " $EXTRA_ARGS " in
    *" --native"*) ;;
    *) return 0 ;;
  esac
  /sbin/modprobe tun 2>/dev/null
  if [ ! -c /dev/net/tun ]; then
    mkdir -p /dev/net
    mknod /dev/net/tun c 10 200 2>/dev/null
    chmod 0600 /dev/net/tun
  fi
}

log_marker() {
  # Write a clearly-formatted banner line to the log so connect/disconnect
  # events stand out. The webGui log viewer highlights these lines.
  printf '%s ==== %s ====\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG"
}

pid_alive() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

is_running() {
  pid_alive && return 0
  pgrep -f "$PGREP_NEWT" >/dev/null 2>&1
}

is_connected() {
  # A live process is not a live tunnel (a wrong secret keeps Newt retrying
  # forever), so trust Newt's own health file, which it removes as soon as the
  # tunnel ping stops succeeding. Note -s, not -e: start() leaves an *empty*
  # health file behind (see reset_health), which must not read as connected.
  is_running && [ -s "$HEALTH" ]
}

reset_health() {
  # Truncate rather than delete. Newt unconditionally removes its health file
  # when it starts pinging and logs "ERROR: Failed to remove health file" if it
  # is not there - a red herring in the log viewer on every single start. An
  # empty file lets that remove succeed silently, and is_connected requires a
  # non-empty file, so an empty one still means "not connected".
  : > "$HEALTH"
}

sync_binary() {
  # Only relevant when the user allowed Newt to update itself: the new binary
  # lands in /usr/local/bin, which is RAM and gone after a reboot. Copy it back
  # to the flash drive so the update survives, and so the plugin restores the
  # updated build rather than silently rolling back on next boot.
  # Called from cron; in steady state this is a single cmp of two files.
  [ "$SELF_UPDATE" = "yes" ] || return 0
  [ -s "$BIN" ] || return 0
  cmp -s "$BIN" "$PERSIST" && return 0
  install -D -m 0755 "$BIN" "${PERSIST}.tmp" && mv -f "${PERSIST}.tmp" "$PERSIST"
  log_marker "Newt self-updated to $("$BIN" --version 2>/dev/null | head -n1), saved to flash"
}

# Launch Newt once and wait for it to report a healthy tunnel.
# Returns: 0 = connected, 1 = process died (config error, retrying is pointless),
#          2 = process alive but never became healthy (worth another attempt).
launch_once() {
  reset_health

  # Credentials go through the environment, never the command line: Newt reads
  # PANGOLIN_ENDPOINT / NEWT_ID / NEWT_SECRET natively, and this keeps the
  # secret out of the process list that any local user can read with `ps`.
  export PANGOLIN_ENDPOINT NEWT_ID NEWT_SECRET

  # Newt's self-updater treats "running in an official container" as "someone
  # else owns my version" and skips itself. That is exactly the plugin's
  # position, so the documented opt-out is reused here.
  if [ "$SELF_UPDATE" = "yes" ]; then
    unset NEWT_SYSTEM_SUBSTRATE
  else
    export NEWT_SYSTEM_SUBSTRATE="CONTAINER"
  fi

  local args=(--health-file "$HEALTH" --log-level "$LOG_LEVEL")
  if [ "$DOCKER_INTEGRATION" = "yes" ] && [ -S /var/run/docker.sock ]; then
    args+=(--docker-socket "unix:///var/run/docker.sock")
  fi

  # EXTRA_ARGS comes last so an explicit user flag overrides our defaults.
  nohup "$BIN" "${args[@]}" $EXTRA_ARGS >> "$LOG" 2>&1 &
  echo $! > "$PIDFILE"

  local tries=0
  while [ "$tries" -lt "$START_WAIT" ]; do
    sleep 0.5
    if ! is_running; then
      rm -f "$PIDFILE"
      return 1
    fi
    [ -s "$HEALTH" ] && return 0
    tries=$((tries+1))
  done
  return 2
}

# Kill the running Newt without clearing the "should be connected" intent.
stop_process() {
  # Newt has no "down" command; it shuts the tunnel down cleanly on SIGTERM
  # (measured: well under a second, including deregistering from the server).
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
    rm -f "$PIDFILE"
  fi
  pkill -f "$PGREP_NEWT" 2>/dev/null
  # Force-kill anything still alive after a short grace period.
  sleep 1
  pkill -9 -f "$PGREP_NEWT" 2>/dev/null
  # Newt only deletes the health file when *it* sees the tunnel drop, so a
  # killed process would leave the settings page reporting "connected".
  rm -f "$HEALTH"
}

start() {
  ensure_bin
  if [ ! -x "$BIN" ]; then
    echo "Newt binary not found at ${BIN}"
    return 1
  fi
  if is_connected; then
    echo "Newt is already connected"
    return 0
  fi
  if [ -z "$PANGOLIN_ENDPOINT" ] || [ -z "$NEWT_ID" ] || [ -z "$NEWT_SECRET" ]; then
    echo "Missing endpoint / newt id / newt secret - configure in Settings > Pangolin Newt"
    return 1
  fi
  ensure_tun

  # From here on the service is meant to be up, so the watchdog may act.
  touch "$WANTFILE"

  echo "Connecting to ${PANGOLIN_ENDPOINT} ..."
  log_marker "Newt connecting to ${PANGOLIN_ENDPOINT}"

  local attempt=1 rc
  while :; do
    # A leftover process from a previous attempt would make is_running true
    # and the new launch redundant, so always start from a clean slate.
    is_running && stop_process
    launch_once
    rc=$?
    case "$rc" in
      0) echo "Newt connected"; return 0 ;;
      1) echo "Newt failed to start - check ${LOG}"; return 1 ;;
    esac
    if [ "$attempt" -ge "$START_ATTEMPTS" ]; then
      break
    fi
    # Newt is alive but never registered, and it will not retry on its own.
    # Only a fresh process helps.
    log_marker "Newt did not connect on attempt ${attempt}, restarting"
    attempt=$((attempt+1))
  done

  # Out of attempts. Leave the process running: it holds a live websocket, the
  # settings page shows the amber "starting" state, and the watchdog will keep
  # trying rather than leaving the site down until someone notices.
  echo "Newt started but has not connected after ${START_ATTEMPTS} attempts - check ${LOG}"
  return 0
}

stop() {
  echo "Disconnecting Newt ..."
  log_marker "Newt disconnecting"
  # Clear the intent first so a watchdog tick racing with us cannot revive it.
  rm -f "$WANTFILE"
  stop_process
  echo "Newt disconnected"
}

watchdog() {
  # Cheap periodic check (called from cron). Newt's registration handshake
  # fails intermittently and, when it does, the process stays alive forever
  # without ever retrying - so without this a site can sit disconnected
  # indefinitely after a boot or a network blip. Does nothing unless the
  # service is meant to be connected but is not.
  [ -f "$WANTFILE" ] || return 0
  is_connected && return 0
  log_marker "Newt watchdog: not connected, restarting"
  stop_process
  sleep 2
  start >/dev/null 2>&1
}

status() {
  if is_connected; then
    echo "connected"
  elif is_running; then
    echo "running"
  else
    echo "stopped"
  fi
}

case "$1" in
  start)       start ;;
  stop)        stop ;;
  restart)     stop_process; sleep 1; start ;;
  # "apply" saves settings and makes a *running* service pick them up. When
  # nothing is running it deliberately does not connect - but say so, because
  # "Settings saved" on its own reads like the connection was made too, and
  # nothing is written to the log to suggest otherwise.
  apply)       if is_running; then stop_process; sleep 1; start; else echo "Settings saved - press Connect to start the tunnel"; fi ;;
  status)      status ;;
  autostart)   [ "$AUTOSTART" = "yes" ] && start || echo "Autostart is disabled" ;;
  watchdog)    watchdog ;;
  sync-binary) sync_binary ;;
  *) echo "Usage: $0 {start|stop|restart|apply|status|autostart|watchdog|sync-binary}"; exit 1 ;;
esac
